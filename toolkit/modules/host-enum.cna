#
# host-enum.cna - Local host situational awareness
#
# Registers the `enum-host` Beacon alias. Gathers identity, OS build,
# patch level, local accounts, running processes, and current privileges
# so the operator can orient on a freshly landed session quickly.
#
# FOR USE ON AUTHORIZED RED TEAM ENGAGEMENTS ONLY.
#

# enum_host(bid) - core routine, also callable from the popup menu / "run all".
sub enum_host {
    local('$bid @cmds');
    $bid = $1;

    enum_log($bid, "host enumeration starting");

    @cmds = @(
        "whoami /all",
        "hostname",
        "ver",
        "systeminfo",
        "wmic qfe get HotFixID,InstalledOn",
        "net user",
        "net localgroup administrators",
        "query user",
        "tasklist /v",
        "wmic product get name,version",
        "set"
    );

    enum_run_each($bid, @cmds);
    enum_log($bid, "host enumeration queued");
}

alias enum-host {
    enum_host($1);
}

beacon_command_register(
    "enum-host",
    "Local host situational awareness",
    "Synopsis: enum-host\n\n" .
    "Collects local host context: identity & privileges (whoami /all),\n" .
    "hostname, OS version, full systeminfo, installed hotfixes, local\n" .
    "users and administrators, logged-on sessions, running processes,\n" .
    "installed software, and environment variables.\n\n" .
    "All commands run via cmd.exe through the current Beacon."
);
